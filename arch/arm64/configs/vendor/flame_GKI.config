# Device Tree Overlay
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC1020=m
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_SILEAD_FP_PLATFORM=m
CONFIG_FINGERPRINT_XIAOMI_FP=m

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Memory
# CONFIG_QCOM_MEM_OFFLINE is not set

# NFC
#CONFIG_NFC_QTI_I2C is not set
CONFIG_NXP_NFC_I2C=m

# Touchscreen
# CONFIG_FTS_TRUSTED_TOUCH is not set
# CONFIG_NOVATEK_TRUSTED_TOUCH is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_FTS_DIRECTORY is not set
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
CONFIG_TOUCHSCREEN_ATMEL_MXT=m
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_COMMON=m
CONFIG_TOUCHSCREEN_FTS_SPI=m

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m
